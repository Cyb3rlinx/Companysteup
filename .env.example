# sandbox runs locally with synthetic data only; production requires supabase
APP_MODE=sandbox
APP_ORIGIN=http://localhost:3000
SANDBOX_SESSION_SECRET=
DOCUMENT_SIGNING_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only AFTER configuring the Google provider in Supabase: SANDBOX or LIVE.
# Google Client Secret belongs in Supabase Auth, never NEXT_PUBLIC_* or this app.
GOOGLE_AUTH_MODE=EXTERNAL_BLOCKED
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COMPLIANCE_PRICE_ID=
COMPANIES_HOUSE_API_KEY=
EMAIL_PROVIDER_API_KEY=
KYC_PROVIDER_SECRET=
SOURCE_MONITOR_USER_AGENT=CompanySetupComplianceBot/0.1
SOURCE_MONITOR_SECRET=
AUTOMATION_USER_ID=
# Optional, only for fresh synthetic fixtures in a NEW isolated sandbox database.
SANDBOX_FIXTURE_TIME=
# Optional isolated PGlite directory for tests; keep it under .local/.
SANDBOX_DATA_DIR=
DELAWARE_PARTNER_API_KEY=
WYOMING_PARTNER_API_KEY=
ESTONIA_PARTNER_API_KEY=
UK_ACSP_PARTNER_API_KEY=
