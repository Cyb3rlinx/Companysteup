{
  "name": "company-setup-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev apps/web --hostname 127.0.0.1",
    "build": "pnpm edge:build && next build apps/web",
    "start": "next start apps/web --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:rls": "vitest run tests/database",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:staging": "tsx scripts/test-staging.ts --synthetic-only",
    "test:agents": "tsx scripts/test-agent-journeys.ts",
    "test:wyoming": "tsx scripts/test-wyoming-packet.ts",
    "test:wyoming-agent": "tsx scripts/test-wyoming-agent-evaluation.ts",
    "test:wyoming-agent:connected": "tsx scripts/test-wyoming-agent-evaluation.ts --connected",
    "test:delaware-agent": "tsx scripts/test-delaware-agent-evaluation.ts",
    "test:delaware-agent:connected": "tsx scripts/test-delaware-agent-evaluation.ts --connected",
    "test:estonia-agent": "tsx scripts/test-estonia-agent-evaluation.ts",
    "test:estonia-agent:connected": "tsx scripts/test-estonia-agent-evaluation.ts --connected",
    "test:uk-agent": "tsx scripts/test-uk-agent-evaluation.ts",
    "test:uk-agent:connected": "tsx scripts/test-uk-agent-evaluation.ts --connected",
    "test:agent-regression": "tsx scripts/test-agent-regression.ts",
    "google-auth:status": "tsx scripts/check-google-auth-readiness.ts",
    "test:google-auth:staging": "tsx scripts/check-google-auth-readiness.ts --require-ready",
    "start:staging": "node scripts/start-staging.mjs",
    "test:integrity": "vitest run tests/regulatory",
    "brain:query": "tsx scripts/graph-memory.ts query",
    "brain:sync": "tsx scripts/graph-memory.ts sync",
    "brain:status": "tsx scripts/graph-memory.ts status",
    "brain:repair": "tsx scripts/graph-memory.ts repair-links",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "sources:fetch": "tsx scripts/fetch-sources.ts",
    "lovable:export": "tsx scripts/export-lovable-context.ts",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "supabase": "node node_modules/supabase/dist/supabase.js",
    "edge:build": "node scripts/build-edge.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "lucide-react": "^0.468.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^18.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.1.6",
    "supabase": "2.116.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "esbuild": "^0.25.9"
  }
}
